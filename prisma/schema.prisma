
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(PATIENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  healthRecords HealthRecord[]
  appointments  Appointment[]
  medications   Medication[]
  documents     Document[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model HealthRecord {
  id          String       @id @default(cuid())
  userId      String
  title       String
  type        RecordType
  description String       @db.Text
  diagnosis   String?
  doctorName  String?
  visitDate   DateTime
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Appointment {
  id          String            @id @default(cuid())
  userId      String
  title       String
  doctorName  String
  specialty   String?
  location    String?
  appointmentDate DateTime
  duration    Int               @default(30) 
  status      AppointmentStatus @default(UPCOMING)
  notes       String?           @db.Text
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Medication {
  id          String   @id @default(cuid())
  userId      String
  name        String
  dosage      String
  frequency   String
  startDate   DateTime
  endDate     DateTime?
  prescribedBy String?
  notes       String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Document {
  id          String       @id @default(cuid())
  userId      String
  title       String
  type        DocumentType
  fileUrl     String
  fileSize    Int?
  mimeType    String?
  summary     String?      @db.Text 
  uploadedAt  DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum RecordType {
  VISIT
  DIAGNOSIS
  PROCEDURE
  VACCINATION
  ALLERGY
  LAB_RESULT
  OTHER
}

enum AppointmentStatus {
  UPCOMING
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum DocumentType {
  LAB_REPORT
  PRESCRIPTION
  IMAGING
  DISCHARGE_SUMMARY
  INSURANCE
  OTHER
}
